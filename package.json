{
  "name": "sol-solar-system",
  "version": "3.8.0",
  "description": "Sol — a true-scale, physically based WebGPU atlas of the Solar System",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit -p .",
    "test": "node tools/run-tests.mjs",
    "check": "npm run typecheck && npm run assets && npm test && npm run build",
    "diag:astro": "esbuild test/astro.test.ts --bundle --platform=node --format=esm --outfile=.cache/astro.mjs --loader:.json=json && node .cache/astro.mjs",
    "qa:smoke": "node tools/qa/smoke.mjs",
    "qa:golden": "node tools/qa/smoke.mjs --script golden --out qa-out/golden",
    "inventory": "python3 tools/validate/inventory.py",
    "ingest:horizons-fixtures": "node tools/ingest/horizons.mjs",
    "ingest:sbdb": "node tools/ingest/sbdb.mjs",
    "ingest:sampled": "node tools/ingest/sampled-ephem.mjs && node tools/ingest/planet-bary.mjs && node tools/ingest/ephem-edges.mjs",
    "ingest:minor-moons": "node tools/ingest/minor-moons.mjs",
    "qa:compare": "python3 tools/qa/compare.py",
    "assets": "node tools/validate/assets.mjs",
    "ingest:dem": "node tools/ingest/dem.mjs",
    "ingest:stars": "node tools/ingest/gaia.mjs",
    "ingest:usgs": "python3 tools/ingest/usgs_mosaics.py --raw tools/ingest/raw/usgs",
    "ingest:shards": "node tools/ingest/shard-stars.mjs",
    "ingest:planets-ext": "node tools/ingest/planets-ext.mjs"
  },
  "dependencies": {
    "astronomia": "^4.2.0",
    "lucide": "^1.52.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "esbuild": "^0.25.10",
    "playwright-core": "^1.56.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "private": true,
  "type": "module",
  "license": "SEE LICENSE IN CREDITS.md"
}